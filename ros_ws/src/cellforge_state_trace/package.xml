  <version>0.1.0</version>
  <description>Cell state aggregation and durable trace event recording for CellForge.</description>
  <maintainer email="engineering@example.invalid">CellForge Engineering</maintainer>
  <license>Proprietary</license>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>cellforge_interfaces</exec_depend>
