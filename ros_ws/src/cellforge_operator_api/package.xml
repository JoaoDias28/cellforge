<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>cellforge_operator_api</name>
  <version>0.2.0</version>
  <description>Offline local operator API, UI, authorization, and audit service.</description>
  <maintainer email="engineering@example.invalid">CellForge Engineering</maintainer>
  <license>Proprietary</license>

  <exec_depend>cellforge_interfaces</exec_depend>
  <exec_depend>python3-fastapi</exec_depend>
  <exec_depend>python3-uvicorn</exec_depend>
  <exec_depend>rclpy</exec_depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
