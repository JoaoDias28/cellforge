{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cellforge.local/schemas/recipe.schema.json",
  "title": "CellForge recipe",
  "x-cellforge": {
    "label": "Recipe",
    "group": "Recipe",
    "order": 0
  },
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "recipe",
    "compatibility",
    "parameters",
    "timeouts",
    "traceability"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1.0",
      "x-cellforge": {
        "label": "Schema version",
        "group": "Metadata",
        "order": 10
      }
    },
    "recipe": {
      "type": "object",
      "x-cellforge": {
        "label": "Recipe identity",
        "group": "Identity",
        "order": 20
      },
      "additionalProperties": false,
      "required": [
        "id",
        "version",
        "name",
        "status"
      ],
      "properties": {
        "id": {
          "type": "string",
          "x-cellforge": {
            "label": "Recipe ID",
            "order": 10
          }
        },
        "version": {
          "type": "integer",
          "minimum": 1,
          "x-cellforge": {
            "label": "Version",
            "order": 20
          }
        },
        "name": {
          "type": "string",
          "x-cellforge": {
            "label": "Name",
            "order": 30
          }
        },
        "status": {
          "enum": [
            "DRAFT",
            "VALIDATED",
            "TESTED",
            "APPROVED",
            "RETIRED"
          ],
          "x-cellforge": {
            "label": "Lifecycle status",
            "group": "Lifecycle",
            "order": 40
          }
        }
      }
    },
    "compatibility": {
      "type": "object",
      "x-cellforge": {
        "label": "Compatibility",
        "group": "Compatibility",
        "order": 30
      },
      "additionalProperties": false,
      "required": [
        "cell_ids",
        "required_capabilities"
      ],
      "properties": {
        "cell_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "required_capabilities": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "component_constraints": {
          "type": "object"
        }
      }
    },
    "product": {
      "type": "object",
      "x-cellforge": {
        "label": "Product",
        "group": "Advanced",
        "order": 40,
        "advanced": true
      }
    },
    "parameters": {
      "type": "object",
      "x-cellforge": {
        "label": "Parameters",
        "group": "Advanced",
        "order": 50,
        "advanced": true
      }
    },
    "limits": {
      "type": "object",
      "x-cellforge": {
        "label": "Limits",
        "group": "Advanced",
        "order": 60,
        "advanced": true
      }
    },
    "timeouts": {
      "type": "object",
      "x-cellforge": {
        "label": "Timeouts",
        "group": "Timing",
        "order": 70,
        "unit": "s",
        "advanced": true,
        "help": "Positive timeout values are expressed in seconds."
      },
      "additionalProperties": {
        "type": "number",
        "exclusiveMinimum": 0
      }
    },
    "retry_policy": {
      "type": "object",
      "x-cellforge": {
        "label": "Retry policy",
        "group": "Advanced",
        "order": 80,
        "advanced": true
      }
    },
    "inspection": {
      "type": "object",
      "x-cellforge": {
        "label": "Inspection",
        "group": "Advanced",
        "order": 90,
        "advanced": true
      }
    },
    "traceability": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "record_fields"
      ],
      "properties": {
        "record_fields": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "capture_before_image": {
          "type": "boolean"
        },
        "capture_after_image": {
          "type": "boolean"
        }
      }
    },
    "approval": {
      "type": "object",
      "x-cellforge": {
        "label": "Approval",
        "group": "Advanced",
        "order": 100,
        "advanced": true
      }
    }
  }
}
