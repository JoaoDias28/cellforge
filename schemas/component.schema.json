{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cellforge.local/schemas/component.schema.json",
  "title": "CellForge component type",
  "x-cellforge": {
    "label": "Component type",
    "group": "Component",
    "order": 0
  },
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "component",
    "assets",
    "frames",
    "ports",
    "capabilities",
    "adapters",
    "support"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1.0",
      "x-cellforge": {
        "label": "Schema version",
        "group": "Metadata",
        "order": 10
      }
    },
    "component": {
      "type": "object",
      "x-cellforge": {
        "label": "Component identity",
        "group": "Identity",
        "order": 20
      },
      "additionalProperties": false,
      "required": [
        "id",
        "version",
        "kind",
        "name"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]+$",
          "x-cellforge": {
            "label": "Component ID",
            "order": 10
          }
        },
        "version": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:[-+][A-Za-z0-9.-]+)?$",
          "x-cellforge": {
            "label": "Version",
            "order": 20
          }
        },
        "kind": {
          "enum": [
            "robot",
            "end_effector",
            "sensor",
            "process_machine",
            "fixture",
            "conveyor",
            "external_axis",
            "io_module",
            "product_carrier",
            "passive_geometry",
            "safety_device"
          ],
          "x-cellforge": {
            "label": "Component kind",
            "order": 30
          }
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "x-cellforge": {
            "label": "Name",
            "order": 40
          }
        },
        "manufacturer": {
          "type": "string",
          "x-cellforge": {
            "label": "Manufacturer",
            "order": 50
          }
        },
        "model": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "license": {
          "type": "string"
        }
      }
    },
    "assets": {
      "type": "object",
      "x-cellforge": {
        "label": "Assets",
        "group": "Assets",
        "order": 30
      },
      "additionalProperties": false,
      "required": [
        "visual_usd",
        "collision_usd"
      ],
      "properties": {
        "visual_usd": {
          "type": "string"
        },
        "collision_usd": {
          "type": "string"
        },
        "urdf": {
          "type": "string"
        },
        "srdf": {
          "type": "string"
        },
        "thumbnail": {
          "type": "string"
        }
      }
    },
    "variants": {
      "type": "object",
      "x-cellforge": {
        "label": "Variants",
        "group": "Advanced",
        "order": 40,
        "advanced": true
      },
      "additionalProperties": {
        "type": "array",
        "items": {
          "type": "string"
        },
        "uniqueItems": true
      }
    },
    "frames": {
      "type": "array",
      "x-cellforge": {
        "label": "Frames",
        "group": "Spatial model",
        "order": 50
      },
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "role"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "role": {
            "enum": [
              "root",
              "mount",
              "tool",
              "sensor",
              "process",
              "calibration",
              "product"
            ]
          },
          "usd_prim": {
            "type": "string"
          }
        }
      },
      "minItems": 1
    },
    "ports": {
      "type": "object",
      "x-cellforge": {
        "label": "Ports",
        "group": "Interfaces",
        "order": 60
      },
      "additionalProperties": false,
      "required": [
        "mechanical",
        "software",
        "industrial_io",
        "safety"
      ],
      "properties": {
        "mechanical": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/port"
          }
        },
        "software": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/port"
          }
        },
        "industrial_io": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/port"
          }
        },
        "safety": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/port"
          }
        }
      }
    },
    "config_schema": {
      "type": "string",
      "x-cellforge": {
        "label": "Configuration schema",
        "group": "Interfaces",
        "order": 70
      }
    },
    "capabilities": {
      "type": "array",
      "x-cellforge": {
        "label": "Capabilities",
        "group": "Interfaces",
        "order": 80
      },
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "contract",
          "version",
          "definition",
          "endpoint"
        ],
        "properties": {
          "contract": {
            "type": "string"
          },
          "version": {
            "type": "string"
          },
          "definition": {
            "type": "string",
            "pattern": "^cellforge://capabilities/[a-z][a-z0-9_.-]*/[0-9]+\\.[0-9]+\\.[0-9]+$"
          },
          "endpoint": {
            "type": "string"
          },
          "modes": {
            "type": "array",
            "items": {
              "enum": [
                "simulation",
                "commissioning",
                "production"
              ]
            },
            "uniqueItems": true
          },
          "limits": {
            "type": "object"
          }
        }
      }
    },
    "adapters": {
      "type": "object",
      "x-cellforge": {
        "label": "Adapters",
        "group": "Adapters",
        "order": 90
      },
      "additionalProperties": false,
      "required": [
        "simulation",
        "hardware"
      ],
      "properties": {
        "simulation": {
          "$ref": "#/$defs/adapter"
        },
        "hardware": {
          "$ref": "#/$defs/adapter"
        }
      }
    },
    "fault_catalog": {
      "type": "string",
      "x-cellforge": {
        "label": "Fault catalog",
        "group": "Advanced",
        "order": 100,
        "advanced": true
      }
    },
    "support": {
      "type": "object",
      "x-cellforge": {
        "label": "Support status",
        "group": "Support",
        "order": 110
      },
      "additionalProperties": false,
      "required": [
        "level",
        "simulation_level"
      ],
      "properties": {
        "level": {
          "enum": [
            "metadata_only",
            "simulated",
            "bench_tested",
            "production_qualified",
            "deprecated"
          ]
        },
        "simulation_level": {
          "enum": [
            "L0",
            "L1",
            "L2",
            "L3"
          ]
        },
        "owner": {
          "type": "string"
        }
      }
    }
  },
  "$defs": {
    "port": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "direction",
        "type"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "direction": {
          "enum": [
            "input",
            "output",
            "bidirectional"
          ]
        },
        "type": {
          "type": "string"
        },
        "frame": {
          "type": "string"
        },
        "required": {
          "type": "boolean",
          "default": false
        },
        "metadata": {
          "type": "object"
        }
      }
    },
    "adapter": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "required": [
        "package",
        "entrypoint"
      ],
      "properties": {
        "package": {
          "type": "string"
        },
        "entrypoint": {
          "type": "string"
        },
        "minimum_version": {
          "type": "string"
        },
        "fidelity": {
          "enum": [
            "L0",
            "L1",
            "L2",
            "L3"
          ]
        }
      }
    }
  }
}
