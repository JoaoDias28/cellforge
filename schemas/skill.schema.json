{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cellforge.local/schemas/skill.schema.json",
  "title": "CellForge skill contract",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "skill", "version", "capabilities", "inputs", "outputs", "faults"],
  "properties": {
    "schema_version": {"const": "0.1.0"},
    "skill": {"type": "string", "pattern": "^[a-z][a-z0-9_.-]+$"},
    "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "capabilities": {"type": "array", "items": {"type": "string", "pattern": "^cellforge://capabilities/.+/.+$"}, "uniqueItems": true},
    "inputs": {"type": "object"},
    "outputs": {"type": "object"},
    "faults": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "cancellable": {"type": "boolean"}
  }
}
