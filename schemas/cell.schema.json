{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cellforge.local/schemas/cell.schema.json",
  "title": "CellForge cell project",
  "x-cellforge": {
    "label": "Cell project",
    "group": "Cell",
    "order": 0
  },
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "cell",
    "scene",
    "components",
    "connections",
    "tasks",
    "recipes",
    "deployment_profiles"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1.0",
      "x-cellforge": {
        "label": "Schema version",
        "group": "Metadata",
        "order": 10
      }
    },
    "cell": {
      "type": "object",
      "x-cellforge": {
        "label": "Cell identity",
        "group": "Cell",
        "order": 20
      },
      "additionalProperties": false,
      "required": [
        "id",
        "name"
      ],
      "properties": {
        "id": {
          "type": "string",
          "x-cellforge": {
            "label": "Cell ID",
            "order": 10
          }
        },
        "name": {
          "type": "string",
          "x-cellforge": {
            "label": "Name",
            "order": 20
          }
        },
        "description": {
          "type": "string",
          "x-cellforge": {
            "label": "Description",
            "order": 30
          }
        }
      }
    },
    "scene": {
      "type": "object",
      "x-cellforge": {
        "label": "Spatial scene",
        "group": "Scene",
        "order": 30
      },
      "additionalProperties": false,
      "required": [
        "usd"
      ],
      "properties": {
        "usd": {
          "type": "string",
          "x-cellforge": {
            "label": "USD stage",
            "order": 10
          }
        },
        "root_prim": {
          "type": "string",
          "default": "/World",
          "x-cellforge": {
            "label": "Root prim",
            "order": 20
          }
        }
      }
    },
    "components": {
      "type": "array",
      "x-cellforge": {
        "label": "Components",
        "group": "Components",
        "order": 40
      },
      "items": {
        "$ref": "#/$defs/component_instance"
      },
      "minItems": 1
    },
    "connections": {
      "type": "array",
      "x-cellforge": {
        "label": "Connections",
        "group": "Connections",
        "order": 50
      },
      "items": {
        "$ref": "#/$defs/connection"
      }
    },
    "tasks": {
      "type": "array",
      "x-cellforge": {
        "label": "Tasks",
        "group": "Behavior",
        "order": 60
      },
      "items": {
        "type": "object",
        "required": [
          "id",
          "behavior_tree"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "behavior_tree": {
            "type": "string"
          },
          "required_capabilities": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "recipes": {
      "type": "array",
      "x-cellforge": {
        "label": "Recipes",
        "group": "Authoring references",
        "order": 70
      },
      "items": {
        "type": "object",
        "required": [
          "schema",
          "path"
        ],
        "properties": {
          "schema": {
            "type": "string"
          },
          "path": {
            "type": "string"
          }
        }
      }
    },
    "calibrations": {
      "type": "array",
      "x-cellforge": {
        "label": "Calibrations",
        "group": "Authoring references",
        "order": 80,
        "advanced": true
      },
      "items": {
        "type": "string"
      }
    },
    "scenarios": {
      "type": "array",
      "x-cellforge": {
        "label": "Scenarios",
        "group": "Authoring references",
        "order": 90
      },
      "items": {
        "type": "string"
      }
    },
    "deployment_profiles": {
      "type": "array",
      "x-cellforge": {
        "label": "Deployment profiles",
        "group": "Deployment",
        "order": 100
      },
      "items": {
        "type": "string"
      },
      "minItems": 1
    }
  },
  "$defs": {
    "component_instance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "alias",
        "component",
        "version",
        "usd_prim",
        "adapter_mode",
        "config"
      ],
      "properties": {
        "id": {
          "type": "string",
          "x-cellforge": {
            "label": "Component instance ID",
            "order": 10
          }
        },
        "alias": {
          "type": "string",
          "x-cellforge": {
            "label": "Alias",
            "order": 20
          }
        },
        "component": {
          "type": "string",
          "x-cellforge": {
            "label": "Component type",
            "order": 30
          }
        },
        "version": {
          "type": "string",
          "x-cellforge": {
            "label": "Component version",
            "order": 40
          }
        },
        "usd_prim": {
          "type": "string",
          "x-cellforge": {
            "label": "USD prim",
            "order": 50
          }
        },
        "variants": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "adapter_mode": {
          "enum": [
            "simulation",
            "hardware",
            "target_selected"
          ],
          "x-cellforge": {
            "label": "Adapter mode",
            "order": 60
          }
        },
        "config": {
          "type": "object",
          "x-cellforge": {
            "label": "Configuration",
            "group": "Component configuration",
            "order": 70,
            "advanced": true
          }
        },
        "calibration_refs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "connection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "from",
        "to"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "kind": {
          "enum": [
            "mechanical",
            "software",
            "industrial_io",
            "safety"
          ],
          "x-cellforge": {
            "label": "Connection kind",
            "order": 10
          }
        },
        "from": {
          "$ref": "#/$defs/endpoint"
        },
        "to": {
          "$ref": "#/$defs/endpoint"
        },
        "config": {
          "type": "object"
        }
      }
    },
    "endpoint": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "component",
        "port"
      ],
      "properties": {
        "component": {
          "type": "string"
        },
        "port": {
          "type": "string"
        }
      }
    }
  }
}
