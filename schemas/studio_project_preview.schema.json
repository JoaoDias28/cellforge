{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cellforge.local/schemas/studio_project_preview.schema.json",
  "title": "CellForge Studio Project Preview",
  "description": "Diagnostic data for a deterministic preview; it is not canonical project source.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "preview_schema_version",
    "draft_id",
    "template_id",
    "destination_directory",
    "starting_mode",
    "simulation_only",
    "schema_versions",
    "cell_id",
    "component_instance_ids",
    "aliases",
    "defaults",
    "generated_paths",
    "candidate_hashes",
    "candidate_hash",
    "findings",
    "required_choices",
    "can_save",
    "confirmation_token"
  ],
  "properties": {
    "preview_schema_version": {
      "type": "string",
      "const": "0.1.0"
    },
    "draft_id": {
      "type": "string",
      "pattern": "^draft-[0-9a-f]{24}$"
    },
    "template_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_-]*$"
    },
    "destination_directory": {
      "type": "string",
      "minLength": 1
    },
    "starting_mode": {
      "type": "string",
      "const": "simulation"
    },
    "simulation_only": {
      "type": "boolean",
      "const": true
    },
    "schema_versions": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "cell_id": {
      "anyOf": [
        {
          "type": "string",
          "format": "uuid"
        },
        {
          "type": "null"
        }
      ]
    },
    "component_instance_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9](?:[a-z0-9._-]*[a-z0-9])?$"
      },
      "uniqueItems": true
    },
    "aliases": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "pattern": "^[a-z0-9](?:[a-z0-9._-]*[a-z0-9])?$"
      }
    },
    "defaults": {
      "type": "object"
    },
    "generated_paths": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^(?!/)(?!.*(?:^|/)[.][.](?:/|$)).+$"
      },
      "uniqueItems": true
    },
    "candidate_hashes": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "pattern": "^[0-9a-f]{64}$"
      }
    },
    "candidate_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "findings": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/finding"
      }
    },
    "required_choices": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/choice"
      }
    },
    "can_save": {
      "type": "boolean"
    },
    "confirmation_token": {
      "type": "string",
      "pattern": "^(?:[0-9a-f]{64})?$"
    }
  },
  "$defs": {
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "severity", "path", "message"],
      "properties": {
        "code": {
          "type": "string",
          "minLength": 1
        },
        "severity": {
          "type": "string",
          "enum": ["info", "warning", "error"]
        },
        "path": {
          "type": "string",
          "minLength": 1
        },
        "message": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "choice": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key", "prompt", "options", "reason", "source"],
      "properties": {
        "key": {
          "type": "string",
          "minLength": 1
        },
        "prompt": {
          "type": "string",
          "minLength": 1
        },
        "options": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "reason": {
          "type": "string",
          "minLength": 1
        },
        "source": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
